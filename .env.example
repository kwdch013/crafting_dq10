# docker compose 用の環境変数設定例
# このファイルを .env にコピーして値を変更する (未作成でもデフォルトで起動可能)
#   cp .env.example .env

# frontend のホスト側公開ポート (デフォルト: 3000)
FRONTEND_PORT=3000

# api のホスト側公開ポート (デフォルト: 8000)
API_PORT=8000

# ブラウザから API へ到達する URL
# 未指定の場合、画面を開いたときのホスト名と API_PORT から自動導出する
#   http://localhost:3000     で開く → http://localhost:8000
#   http://192.168.0.100:3000 で開く → http://192.168.0.100:8000
# frontend とは別ホストで API を公開する場合のみ指定する
# API_BASE_URL=http://api.example.com:8000

# レシピの保存先 (json | postgres)。段階2までは json のみ動作する
RECIPE_STORE=json

# PostgreSQL への接続先。認証情報を含むため .env にだけ実値を書く
# ホスト名は postgres_db コンテナ名、ネットワークは database_default を使う
# DATABASE_URL=postgresql://crafting_dq10:<password>@postgres_db:5432/crafting_dq10
# 結合テスト用DB。未設定ならDBが必要なテストはスキップする
# TEST_DATABASE_URL=postgresql://crafting_dq10:<password>@postgres_db:5432/crafting_dq10_test
