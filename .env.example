# docker compose 用の環境変数設定例
# このファイルを .env にコピーして値を変更する (未作成でもデフォルトで起動可能)
#   cp .env.example .env

# frontend のホスト側公開ポート (デフォルト: 3000)
FRONTEND_PORT=3000

# api のホスト側公開ポート (デフォルト: 8000)
API_PORT=8000

# ブラウザから API へ到達する URL (デフォルト: http://localhost:${API_PORT})
# API_PORT を変更した場合は自動で追従するため、通常は指定不要
# 別ホストで API を公開する場合のみ指定する
# API_BASE_URL=http://localhost:8000
